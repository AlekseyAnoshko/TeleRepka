[Unit]
Description=Chromium в режиме киоска — показывает панель лаборатории на ТВ
After=lab-hub.service graphical.target
Wants=lab-hub.service

[Service]
Type=simple
User=user
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/user/.Xauthority
ExecStartPre=/bin/sh -c 'until curl -sk http://localhost:5000/ -o /dev/null; do sleep 1; done'
ExecStart=/usr/bin/chromium \
  --kiosk \
  --noerrdialogs \
  --disable-infobars \
  --no-first-run \
  --disable-session-crashed-bubble \
  --autoplay-policy=no-user-gesture-required \
  --ignore-certificate-errors \
  --check-for-update-interval=31536000 \
  http://localhost:5000/
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical.target
